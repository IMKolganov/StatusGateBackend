POSTGRES_USER=statusgate
POSTGRES_PASSWORD=statusgate
POSTGRES_DB=statusgate
POSTGRES_PORT=5432

BACKEND_PORT=8000

APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

JWT_SECRET=replace-with-at-least-32-characters-long-random-secret
JWT_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_TOKEN_EXPIRE_MINUTES=5

ALLOW_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=false
REQUIRE_HTTPS=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTH_LOGIN_RATE_LIMIT=5/minute

DEFAULT_POLL_INTERVAL_SECONDS=60
SCHEDULER_INTERVAL_SECONDS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated hosts allowed for DataGate Monitor integration base_url.
DATAGATE_ALLOWED_HOSTS=api.datagateapp.com,localhost,127.0.0.1
# Optional key for encrypting DataGate client_secret at rest (else derived from JWT_SECRET).
DATAGATE_CREDENTIALS_KEY=

TOTP_ISSUER=StatusGate

# Network probes / speed test (optional; hardcoded fallbacks used when unset).
# Keep in sync with the root StatusGate .env.example and frontend VITE_* placeholders.
# DEFAULT_SPEED_TEST_URL_TEMPLATE=https://speed.cloudflare.com/__down?bytes={bytes}
# CLOUDFLARE_SPEED_TEST_ORIGIN=https://speed.cloudflare.com
# DEFAULT_PROBE_URL=https://ifconfig.me/ip
# GOOGLE_PROBE_URL=https://www.gstatic.com/generate_204
# INTERNET_PING_HOST=8.8.8.8
# VPN_NETNS_DNS_SERVERS=1.1.1.1,8.8.8.8
# Shared by API + worker (docker volume statusgate_data):
# HOST_WAN_BASELINE_PATH=/var/lib/statusgate/host_wan_baseline.json
